# SDRAngel REST API base URL (default: http://localhost:8091)
SDRANGEL_BASE_URL=http://localhost:8091

# Request timeout (default: 10s)
# SDRANGEL_TIMEOUT=10s

# Log level: debug, info, warn, error (default: info)
# SDRANGEL_LOG_LEVEL=info

# Optional HTTP basic auth (most SDRAngel setups don't require this)
# SDRANGEL_USERNAME=
# SDRANGEL_PASSWORD=
